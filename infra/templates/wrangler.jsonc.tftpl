// GENERATED BY TERRAFORM — do not edit. Source: infra/templates/wrangler.jsonc.tftpl
// Re-run `terraform apply` in infra/ to regenerate.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "${name}",
  "account_id": "${account_id}",
  "main": "${worker_entry}",
  "compatibility_date": "${compatibility_date}",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": ${has_domain ? "false" : "true"},
%{ if has_domain ~}
  "routes": [{ "pattern": "${domain}", "custom_domain": true }],
%{ endif ~}
  "assets": {
    "directory": "${assets_dir}",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/auth/*"]
  },
  "vars": {
    "ENVIRONMENT": "${environment}",
    "GOOGLE_CLIENT_ID": "${google_client_id}",
    "CF_ACCOUNT_ID": "${account_id}",
    "ADMIN_EMAILS": "${admin_emails}",
    "ACCESS_AUD": "${access_aud}",
    "ACCESS_TEAM_DOMAIN": "${access_team_domain}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "${d1_name}",
      "database_id": "${d1_id}"%{ if d1_migrations_dir != "" },
      "migrations_dir": "${d1_migrations_dir}"%{ endif }
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "${kv_id}" }],
  "r2_buckets": [{ "binding": "MEDIA_CACHE", "bucket_name": "${r2_bucket}" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "${queue_name}" }],
    "consumers": [{ "queue": "${queue_name}", "max_batch_size": 10, "max_retries": 3, "max_batch_timeout": 5 }]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_ROOM", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
