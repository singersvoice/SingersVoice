{
  "name": "@singersvoice/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SingersVoice PWA (iOS · Android · web) — Preact + Vite + TypeScript",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@singersvoice/protocol": "2.0.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
