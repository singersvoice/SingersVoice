{
  "name": "singersvoice",
  "private": true,
  "version": "2.0.0",
  "description": "SingersVoice v2 — lyrics-first karaoke for iOS, Android and the web. Recordings live in the singer's own Google Drive.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "budget": "node tools/ci/check-budget.mjs apps/web/dist 400",
    "screenshots": "node tools/ci/screenshots.mjs",
    "control": "npm run dev -w services/control"
  }
}
