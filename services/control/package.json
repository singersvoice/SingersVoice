{
  "name": "@singersvoice/control",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "sv-control — the SVT DB API: public track catalog, live meets (stage slots, GMT kickstart, chat, 5-min idle expiry), publishing destinations/jobs. Hono on Node 22 or Cloudflare Workers (SQLite Durable Object).",
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --watch src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node ../../tools/cf/deploy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@singersvoice/protocol": "2.0.0",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
