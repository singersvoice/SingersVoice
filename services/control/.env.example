# sv-control — environment (Node). On the Cloudflare Worker the same names are Worker secrets / vars
# (`npx wrangler secret put NAME`). Never commit a filled-in copy; .env.local is git-ignored.

# Stripe (docs/stripe-setup.md). Test keys first (sk_test_…); live keys only when going live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back (the app's URL, no trailing slash).
APP_URL=https://www.singersvoice.com

# Who is a super admin whatever the database says (comma-separated emails); the first account ever is one too.
PRIVILEGED_EMAILS=

# The coupon gate (Admin → Coupons): on unless 0 — singers need the coupon issued to their email address to use SingersVoice.
# The Admin page's switch decides once it has been used; this is only the start value.
COUPONS_REQUIRED=1

# The RTMP relay (docs/RELAY.md), optional.
RELAY_URL=
RELAY_SECRET=

# Optional: a Google API key for reading published tracks through the Drive API.
GOOGLE_API_KEY=

# Posting clips to the networks (docs/SOCIAL.md), optional: the developer apps' ids and secrets, and this
# service's own public URL (the networks send the browser back to SERVICE_URL/social/<x|meta>/callback).
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
SERVICE_URL=
