{
  // sv-control on Cloudflare Workers (free tier). The SVT DB is a SQLite-backed Durable Object,
  // so a plain "Edit Cloudflare Workers" API token is all a deploy needs. tools/cf/deploy.mjs
  // writes .generated/wrangler.jsonc from this file with the vars filled in.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sv-control",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "ALLOWED_ORIGINS": "https://singersvoice.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "SVT_DB", "class_name": "SvtDb" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SvtDb"] }]
}
